rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // User Helper Functions
    function isAuthenticated() {
      return request.auth != null;
    }

    function getUserData() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data;
    }

    function getRankLevel(rank) {
      let levels = {
        'member': 1,
        'user': 1,
        'analyst': 2,
        'moderator': 2,
        'research_analyst': 3,
        'senior_analyst': 4,
        'lead_analyst': 5,
        'intelligence_specialist': 6,
        'regional_intelligence_officer': 7,
        'strategic_intelligence_officer': 8,
        'afrosint_fellow': 9,
        'administrator': 10,
        'super_admin': 11
      };
      return levels[rank.lower().replace(' ', '_')] || 0;
    }

    function isAnalystPlus() {
      return isAuthenticated() && (
        getRankLevel(getUserData().rank) >= 2 ||
        getRankLevel(getUserData().role) >= 2
      );
    }

    function isAdmin() {
      return isAuthenticated() && (getUserData().role == 'admin' || getUserData().role == 'super_admin');
    }

    // Reports Collection
    match /reports/{reportId} {
      // Analysts and above can read non-draft reports.
      // Users can read their own reports (including drafts).
      allow read: if isAuthenticated() && (
        isAnalystPlus() ||
        resource.data.createdBy == request.auth.uid
      );

      // Eligibility: Analyst level (2) or above to submit.
      allow create: if isAnalystPlus() &&
        request.resource.data.createdBy == request.auth.uid &&
        request.resource.data.status in ['Draft', 'Pending'];

      // Update rules:
      // 1. Owners can update their own drafts.
      // 2. Analysts can update status and notes of submitted reports.
      allow update: if isAuthenticated() && (
        (resource.data.createdBy == request.auth.uid && resource.data.status == 'Draft') ||
        (isAnalystPlus() && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status', 'analystNotes', 'verified', 'updatedAt', 'updatedBy']))
      );

      // Deletion restricted to admins.
      allow delete: if isAdmin();
    }

    // Users collection (existing rules assumption)
    match /users/{userId} {
      allow read: if isAuthenticated();
      allow write: if request.auth.uid == userId || isAdmin();
    }
  }
}
