rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // User Helper Functions
    function isAuthenticated() {
      return request.auth != null;
    }

    function getUserData() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data;
    }

    function getRankLevel(rank) {
      let levels = {
        'member': 1,
        'user': 1,
        'analyst': 2,
        'moderator': 2,
        'admin': 10,
        'administrator': 10,
        'senior_analyst': 3,
        'lead_analyst': 4,
        'regional_coordinator': 5,
        'deputy_chief_analyst': 6,
        'chief_analyst': 7,
        'afrosint_fellow': 8,
        'super_admin': 11
      };
      return levels[rank.lower().replace(' ', '_')] || 0;
    }

    function isAnalystPlus() {
      return isAuthenticated() && (
        getRankLevel(getUserData().rank) >= 2 ||
        getRankLevel(getUserData().role) >= 2
      );
    }

    function canReviewReports() {
      let data = getUserData();
      let rankLvl = getRankLevel(data.rank);
      let roleLvl = getRankLevel(data.role);
      return isAuthenticated() && (
        (rankLvl >= 3 && rankLvl <= 7) ||
        roleLvl >= 10
      );
    }

    function isAdmin() {
      return isAuthenticated() && getRankLevel(getUserData().role) >= 10;
    }

    function canPromote(userRank, targetRank) {
      let userLvl = getRankLevel(userRank);
      let targetLvl = getRankLevel(targetRank);
      return (userLvl == 7) ||
             (userLvl == 6 && (targetLvl >= 2 && targetLvl <= 5)) ||
             (userLvl == 5 && targetLvl == 4) ||
             (userLvl == 4 && (targetLvl == 2 || targetLvl == 3));
    }

    function canSuspend(userRank, targetRank) {
      let userLvl = getRankLevel(userRank);
      let targetLvl = getRankLevel(targetRank);
      return (userLvl == 7) ||
             (userLvl == 6 && targetLvl < 7) ||
             (userLvl == 5 && targetLvl < 5);
    }

    // Reports Collection
    match /reports/{reportId} {
      allow read: if isAuthenticated() && (
        isAnalystPlus() ||
        resource.data.createdBy == request.auth.uid
      );

      allow create: if isAnalystPlus() &&
        request.resource.data.createdBy == request.auth.uid &&
        request.resource.data.status in ['Draft', 'Pending'];

      allow update: if isAuthenticated() && (
        (resource.data.createdBy == request.auth.uid && resource.data.status == 'Draft') ||
        (canReviewReports() && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status', 'analystNotes', 'verified', 'updatedAt', 'updatedBy']))
      );

      allow delete: if isAdmin();
    }

    // Users collection
    match /users/{userId} {
      allow read: if isAuthenticated();
      allow create: if isAuthenticated() && request.auth.uid == userId;
      allow delete: if isAdmin();

      allow update: if isAuthenticated() && (
        (request.auth.uid == userId && !request.resource.data.diff(resource.data).affectedKeys().hasAny(['rank', 'role', 'clearance', 'suspended', 'disabled'])) ||
        isAdmin() ||
        (
          request.resource.data.diff(resource.data).affectedKeys().hasOnly(['rank', 'suspended', 'disabled', 'clearance']) &&
          (
            !request.resource.data.diff(resource.data).affectedKeys().hasAny(['rank']) ||
            (canPromote(getUserData().rank, request.resource.data.rank) && getRankLevel(getUserData().rank) >= getRankLevel(resource.data.rank))
          ) &&
          (
            !request.resource.data.diff(resource.data).affectedKeys().hasAny(['suspended', 'disabled']) ||
            (canSuspend(getUserData().rank, resource.data.rank) && getRankLevel(getUserData().rank) >= getRankLevel(resource.data.rank))
          )
        )
      );
    }
  }
}
