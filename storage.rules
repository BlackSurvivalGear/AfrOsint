rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {
    match /reports/{reportId}/{fileName} {
      // Helper function for storage rules
      function getRankLevel(rank) {
        let levels = {
          'member': 1, 'user': 1,
          'analyst': 2, 'moderator': 2,
          'senior_analyst': 3, 'lead_analyst': 4,
          'regional_coordinator': 5, 'deputy_chief_analyst': 6,
          'chief_analyst': 7, 'afrosint_fellow': 8,
          'administrator': 10, 'super_admin': 11
        };
        return levels[rank.lower().replace(' ', '_')] || 0;
      }

      function isAnalystPlus() {
        let userData = firestore.get(/databases/(default)/documents/users/$(request.auth.uid)).data;
        return getRankLevel(userData.rank) >= 2 || getRankLevel(userData.role) >= 2;
      }

      // Only authenticated users with Analyst rank or above can upload
      // and only to a report they are creating (or if they are an admin)
      allow write: if request.auth != null &&
                   isAnalystPlus() &&
                   request.resource.size < 10 * 1024 * 1024; // 10MB limit

      // Analysts and above can read report attachments
      allow read: if request.auth != null && isAnalystPlus();
    }
  }
}
